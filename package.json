{
  "name": "@andrewveraside/dsh-wps-sidebar",
  "version": "1.4.0",
  "description": "DeepSeek Harness 的 WPS 侧栏办公插件（Windows）：AI 直接在你打开的 WPS 文字 / 表格 / 演示里改文档，改动实时出现在窗口中，你可以同时编辑；读结构、批量编辑、渲染成图核对、保存。在 WPS 基础上补齐题注与交叉引用、修订留痕与对比、域、分节、透视表刷新与切片器、表格转区间、数字格式、图片与形状，以及类似 git 的版本存档：每次保存前把上一版留在文档旁的 .dsh-versions 里，可随时列出版本并回退。",
  "type": "module",
  "author": "andrewveraside",
  "homepage": "https://github.com/andrewveraside/dsh-wps-sidebar",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "helper/OfficeHelper.cs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsdown",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run",
    "smoke": "node scripts/office-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "office",
    "word",
    "excel",
    "powerpoint",
    "docx",
    "xlsx",
    "pptx",
    "com-automation",
    "windows",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "temml": "0.13.5",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.28.0"
}
